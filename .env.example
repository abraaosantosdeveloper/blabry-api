# Cópia sem segredos do .env — serve de referência para quem clona o projeto
# e para lembrar quais variáveis precisam existir em produção (Railway).
# Copie para .env e preencha.

# ---------- Banco de dados ----------
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# ---------- Sessão e token ----------
SESSION_SECRET=
JWT_SECRET=

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
# Origem autorizada no CORS.
FRONTEND_URL=http://localhost:5173

# ---------- Cloudinary (fotos de perfil) ----------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# ---------- Resend (códigos de verificação por e-mail) ----------
# Chave de API do Resend (https://resend.com/api-keys).
# Se ficar VAZIA e NODE_ENV não for production, os e-mails são impressos no
# console em vez de enviados — dá para rodar o projeto inteiro sem conta no
# provedor. Em produção, a ausência da chave faz as rotas de código
# responderem 503, porque um envio silenciosamente não realizado seria pior.
RESEND_API_KEY=

# Remetente. Precisa ser de um domínio verificado no Resend. Enquanto o
# domínio próprio não estiver verificado, use o endereço de testes deles:
# Blabry <onboarding@resend.dev>
EMAIL_REMETENTE=Blabry <onboarding@resend.dev>
