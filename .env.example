# Cópia sem segredos do .env — serve de referência para quem clona o projeto
# e para lembrar quais variáveis precisam existir em produção (Railway).
# Copie para .env e preencha.

# ---------- Banco de dados ----------
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# ---------- Sessão e token ----------
SESSION_SECRET=
JWT_SECRET=

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
# Origem autorizada no CORS.
FRONTEND_URL=http://localhost:5173

# ---------- Cloudinary (fotos de perfil) ----------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# ---------- Resend (códigos de verificação por e-mail) ----------
# Chave de API do Resend (https://resend.com/api-keys).
# Se ficar VAZIA e NODE_ENV não for production, os e-mails são impressos no
# console em vez de enviados — dá para rodar o projeto inteiro sem conta no
# provedor. Em produção, a ausência da chave faz as rotas de código
# responderem 503, porque um envio silenciosamente não realizado seria pior.
RESEND_API_KEY=

# Remetente. Precisa ser de um domínio verificado no Resend, e a parte antes
# do @ é livre — não precisa existir caixa postal para ela.
#
# O domínio do projeto é blabry.com.br, registrado no Registro.br. Os três
# registros que o Resend pede (DKIM, SPF e MX de bounce) ficam na zona DNS
# de lá.
#
# Enquanto o painel não marcar o domínio como "Verified", use o endereço de
# testes do Resend — que só entrega para o e-mail da própria conta, e serve
# para desenvolver, não para atender usuários.
EMAIL_REMETENTE=Blabry <onboarding@resend.dev>
# Produção, com o domínio verificado:
# EMAIL_REMETENTE=Blabry <nao-responda@blabry.com.br>

# ---------- Aparência dos e-mails ----------
# URL pública da logo exibida no topo. Opcional: sem ela, o e-mail sai só
# com texto, e continua correto.
#
# PRECISA ser PNG ou JPEG. A maioria dos clientes de e-mail não renderiza
# SVG, e o Gmail é um deles — a logo do projeto é SVG e precisa ser
# exportada antes de subir.
#
# Suba com o dobro da largura exibida (240px para exibir 120px), para não
# ficar borrada em tela de alta densidade.
EMAIL_LOGO_URL=
